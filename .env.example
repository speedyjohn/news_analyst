# --- база ---
DATABASE_URL=postgresql+psycopg://news:news@localhost:5433/news
SECRET_KEY=change-me-in-production
TIMEZONE=Asia/Almaty
PUBLIC_BASE_URL=http://localhost:5173

# --- LLM ---
LLM_PROVIDER=claude              # claude | openai | deepseek
LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_EFFORT=medium                # low | medium | high | xhigh | max
LLM_REFUSAL_FALLBACK=true
LLM_DAILY_CALL_LIMIT=2000

# --- сбор ---
INGESTION_HOUR=7
INGESTION_MINUTE=0
HTTP_TIMEOUT=20
HTTP_VERIFY_SSL=true
INGESTION_MAX_ITEMS=40

# --- почта ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true

# --- лимиты ---
QUESTIONS_PER_DAY=15
QUESTIONS_PER_HOUR=5
LEGAL_PER_DAY=5

# --- auth ---
JWT_TTL_HOURS=720
COOKIE_SECURE=false
